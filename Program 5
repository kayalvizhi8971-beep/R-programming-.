# Creating first data
name <- c("Arun", "Bala", "Kumar")
mark <- c(80, 90, 75)

# cbind() - Join columns

result1 <- cbind(name, mark)

cat("Using cbind():\n")
print(result1)


# Creating rows

student1 <- c("Arun", 80)
student2 <- c("Bala", 90)
student3 <- c("Kumar", 75)

# rbind() - Join rows

result2 <- rbind(student1, student2, student3)

cat("\nUsing rbind():\n")
print(result2)
