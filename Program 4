n <- as.integer(readline("Enter how many prime numbers: "))

count <- 0
num <- 2

cat("First", n, "prime numbers are:\n")

while (count < n) {
  
  flag <- TRUE
  
  if (num > 2) {
    
    for (i in 2:(num - 1)) {
      
      if (num %% i == 0) {
        
        flag <- FALSE
        break
        
      }
    }
  }
  
  if (flag == TRUE) {
    
    cat(num, " ")
    count <- count + 1
    
  }
  
  num <- num + 1
}
